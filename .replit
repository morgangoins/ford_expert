modules = ["python-3.11"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["glibcLocales"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Ford Inventory Website"

[[workflows.workflow]]
name = "Ford Inventory Website"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python app.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 41489
externalPort = 3002

[[ports]]
localPort = 43557
externalPort = 3001

[[ports]]
localPort = 45197
externalPort = 3000

[deployment]
deploymentTarget = "autoscale"
run = ["python", "app.py"]
